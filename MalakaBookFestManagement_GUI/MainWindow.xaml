<Window x:Class="MalakaBookFestManagement_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Malaka Book Fest - Login" Height="520" Width="800"
        Style="{StaticResource CustomWindowStyle}"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">
    
    <Window.Resources>
        <!-- Style for switching header text -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="WELCOME BACK"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                    <Setter Property="Text" Value="CREATE ACCOUNT"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for switching submit button text -->
        <Style x:Key="SubmitButtonStyle" TargetType="Button" BasedOn="{StaticResource P3RPrimaryButtonStyle}">
            <Setter Property="Content" Value="LOGIN"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                    <Setter Property="Content" Value="REGISTER"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for switching toggle link text -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Content" Value="DON'T HAVE AN ACCOUNT? REGISTER"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                    <Setter Property="Content" Value="ALREADY HAVE AN ACCOUNT? LOGIN"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Register panel visibility style -->
        <Style x:Key="RegisterFieldsStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Overlay / Decorative P3R shapes -->
        <Canvas ClipToBounds="True" Background="Transparent">
            <!-- Sleek background elements to feel premium and P3R like -->
            <Path Fill="#071224" Data="M 0,0 L 500,0 L 200,600 L 0,600 Z"/>
            <Path Fill="#143460" Opacity="0.1" Data="M 400,0 L 800,0 L 800,400 L 600,600 Z"/>
        </Canvas>

        <!-- Title bar -->
        <Grid Height="35" VerticalAlignment="Top" Background="Transparent">
            <TextBlock Text="MALAKA BOOK FEST SYSTEM" Foreground="{StaticResource SecondaryTextBrush}" 
                       VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" FontSize="11" />

            <Button Width="40" HorizontalAlignment="Right" Content="✕" 
                    Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" 
                    BorderThickness="0" Click="CloseButton_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Main Card -->
        <Border Width="400" Height="440" Background="{StaticResource GlassBgBrush}" 
                BorderBrush="#1A2F4C" BorderThickness="1"
                CornerRadius="8" Margin="0,35,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.6" ShadowDepth="8"/>
            </Border.Effect>

            <Grid>
                <StackPanel Margin="45,35,45,35" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeaderTextStyle}"/>

                    <!-- Full Name field (Register only) -->
                    <StackPanel Style="{StaticResource RegisterFieldsStyle}">
                        <TextBlock Text="FULL NAME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,5" FontWeight="Bold" />
                        <TextBox Height="30" Background="Transparent" Style="{StaticResource P3RTextBoxStyle}"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>
                    </StackPanel>

                    <!-- Email Field -->
                    <TextBlock Text="EMAIL ADDRESS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,5" FontWeight="Bold" />
                    <TextBox Height="30" Background="Transparent" Style="{StaticResource P3RTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                    <!-- Password Field -->
                    <TextBlock Text="PASSWORD" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,5" FontWeight="Bold" />
                    <PasswordBox x:Name="PasswordInput" Height="30" Background="Transparent" Style="{StaticResource P3RPasswordBoxStyle}" Margin="0,0,0,15"/>

                    <!-- Error Output Message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" 
                               FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <!-- Submit Button -->
                    <Button Height="40" Style="{StaticResource SubmitButtonStyle}" Click="SubmitButton_Click" Margin="0,0,0,15"/>

                    <!-- Switch Mode Button link -->
                    <Button Style="{StaticResource ToggleButtonStyle}" Command="{Binding ToggleModeCommand}"/>
                </StackPanel>

                <!-- Skeleton Loading Bar -->
                <ProgressBar Style="{StaticResource P3RProgressBarStyle}" VerticalAlignment="Bottom" Margin="0,0,0,0"
                             IsIndeterminate="True" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
