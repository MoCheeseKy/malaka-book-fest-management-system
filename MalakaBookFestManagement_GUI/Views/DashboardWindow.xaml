<Window x:Class="MalakaBookFestManagement_GUI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MalakaBookFestManagement_GUI.ViewModels"
        xmlns:v="clr-namespace:MalakaBookFestManagement_GUI.Views"
        Title="Malaka Book Fest - Dashboard" Height="750" Width="1300"
        Style="{StaticResource CustomWindowStyle}"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Map ViewModels to their respective UserControl Views -->
        <DataTemplate DataType="{x:Type vm:DashboardOverviewViewModel}">
            <v:DashboardOverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BooksViewModel}">
            <v:BooksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TicketsViewModel}">
            <v:TicketsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoothsViewModel}">
            <v:BoothsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TalkshowsViewModel}">
            <v:TalkshowsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <v:UsersView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Main Layout Split: Sidebar and Content Area -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR PANEL -->
        <Border Grid.Column="0" Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Profile / App Logo -->
                    <RowDefinition Height="*"/>    <!-- Navigation links -->
                    <RowDefinition Height="Auto"/> <!-- Logout Area -->
                </Grid.RowDefinitions>

                <!-- Brand & Profile Card -->
                <StackPanel Grid.Row="0" Margin="25,30,25,20">
                    <TextBlock Text="MALAKA BOOK FEST" Foreground="{StaticResource AccentBrush}" 
                               FontSize="16" FontWeight="Bold"  Margin="0,0,0,25"/>

                    <!-- User Profile Area -->
                    <Border BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="6" Background="#0C1D36" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{Binding UserFullName}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding UserEmail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            
                            <!-- Role Badge -->
                            <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="3" Padding="6,2">
                                <TextBlock Text="{Binding UserRole}" Foreground="#0A192F" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                    <TextBlock Text="MANAGEMENT PANEL" Foreground="{StaticResource SecondaryTextBrush}" 
                               FontSize="9" FontWeight="Bold"  Margin="25,0,0,15"/>

                    <!-- Nav Buttons -->
                    <Button Content="Dashboard Overview" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Binding Path="IsDashboardActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>

                    <Button Content="Booths Management" Command="{Binding NavigateCommand}" CommandParameter="Booths">
                        <Button.Style>
                            <Binding Path="IsBoothsActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>

                    <Button Content="Books Catalog" Command="{Binding NavigateCommand}" CommandParameter="Books">
                        <Button.Style>
                            <Binding Path="IsBooksActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>

                    <Button Content="Talkshows Schedule" Command="{Binding NavigateCommand}" CommandParameter="Talkshows">
                        <Button.Style>
                            <Binding Path="IsTalkshowsActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>

                    <Button Content="Ticketing System" Command="{Binding NavigateCommand}" CommandParameter="Tickets">
                        <Button.Style>
                            <Binding Path="IsTicketsActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>

                    <!-- Users (Admin only) -->
                    <Button Content="Users &amp; Roles" Command="{Binding NavigateCommand}" CommandParameter="Users"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Binding Path="IsUsersActive">
                                <Binding.Converter>
                                    <v:ActiveStyleConverter ActiveStyle="{StaticResource P3RSideMenuActiveButtonStyle}" InactiveStyle="{StaticResource P3RSideMenuButtonStyle}"/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Logout / Bottom Area -->
                <Button Grid.Row="2" Content="LOGOUT SYSTEM" Command="{Binding LogoutCommand}" Margin="25,0,25,30" 
                        Style="{StaticResource P3RSecondaryButtonStyle}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Header / custom title controls -->
                <RowDefinition Height="*"/>  <!-- Dynamic views content -->
            </Grid.RowDefinitions>

            <!-- Custom Title bar header -->
            <Grid Grid.Row="0" Background="#071224">
                <TextBlock Text="MALAKA BOOK FEST SYSTEM // DESKTOP CLIENT" Foreground="{StaticResource SecondaryTextBrush}" 
                           VerticalAlignment="Center" Margin="25,0,0,0" FontWeight="SemiBold" FontSize="10" />

                <!-- Minimize & Close Buttons -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Width="40" Height="50" Content="—" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" 
                            BorderThickness="0" Click="MinimizeButton_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="40" Height="50" Content="✕" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" 
                            BorderThickness="0" Click="CloseButton_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Switchable Page Content -->
            <Grid Grid.Row="1" Margin="25">
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
