<UserControl x:Class="MalakaBookFestManagement_GUI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Progress -->
            <RowDefinition Height="*"/>    <!-- Layout Split -->
        </Grid.RowDefinitions>

        <ProgressBar Style="{StaticResource P3RProgressBarStyle}" IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     VerticalAlignment="Top" Margin="0,-15,0,15"/>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="USERS &amp; ROLES MANAGEMENT" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Modify system user roles and toggle account active states (Admin only)." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- Main Grid split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Users list -->
                <ColumnDefinition Width="30"/>  <!-- Gap -->
                <ColumnDefinition Width="2*"/> <!-- Form -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Users list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Button Grid.Row="0" Content="REFRESH LIST" Height="32" Padding="15,0" Margin="0,0,0,15"
                        Style="{StaticResource P3RSecondaryButtonStyle}" Command="{Binding LoadUsersCommand}"/>
                
                <DataGrid Grid.Row="1" Style="{StaticResource P3RDataGridStyle}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="1.5*"/>
                        <DataGridTextColumn Header="EMAIL ADDRESS" Binding="{Binding Email}" Width="2*"/>
                        <DataGridTextColumn Header="SYSTEM ROLE" Binding="{Binding Role}" Width="*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding IsActive}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- RIGHT: Edit panel -->
            <Border Grid.Column="2" Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top">
                <Grid>
                    <!-- Prompt user to select if null -->
                    <TextBlock Text="Select a user from the list to modify their role and active status." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,50,0,50" TextAlignment="Center" Height="50" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Edit Fields (visible if selected) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="MODIFY PRIVILEGES" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" />

                        <!-- User Name (Read only) -->
                        <TextBlock Text="FULL NAME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding SelectedUser.FullName}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- User Email (Read only) -->
                        <TextBlock Text="EMAIL ADDRESS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding SelectedUser.Email}" Foreground="White" FontSize="13" Margin="0,0,0,20"/>

                        <!-- Role Selector -->
                        <TextBlock Text="SYSTEM ROLE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <ComboBox Height="32" Style="{StaticResource P3RComboBoxStyle}" 
                                  ItemsSource="{Binding Roles}" 
                                  SelectedItem="{Binding SelectedRole}" 
                                  Margin="0,0,0,20"/>

                        <!-- IsActive Checkbox -->
                        <CheckBox IsChecked="{Binding IsActive}" Foreground="White" Margin="0,0,0,25" VerticalContentAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="Box" Width="16" Height="16" BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="1" Background="Transparent" CornerRadius="2" Margin="0,0,8,0">
                                                        <Path x:Name="Check" Data="M 2 5 L 5 8 L 10 2" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                                                    </Border>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                            <TextBlock Text="ACCOUNT ACTIVE STATUS" FontSize="11" FontWeight="SemiBold"/>
                        </CheckBox>

                        <!-- Error/Success Info display -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Save changes button -->
                        <Button Content="SAVE PRIVILEGES" Height="40" Style="{StaticResource P3RPrimaryButtonStyle}" Command="{Binding SaveChangesCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
