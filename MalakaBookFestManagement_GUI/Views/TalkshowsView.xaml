<UserControl x:Class="MalakaBookFestManagement_GUI.Views.TalkshowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Progress -->
            <RowDefinition Height="*"/>    <!-- Layout Split -->
        </Grid.RowDefinitions>

        <ProgressBar Style="{StaticResource P3RProgressBarStyle}" IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     VerticalAlignment="Top" Margin="0,-15,0,15"/>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="TALKSHOWS SCHEDULE" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Browse talkshows with guest speakers, register for seats, or advance scheduling statuses." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- Main Grid Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Talkshows List -->
                <ColumnDefinition Width="30"/>  <!-- Gap -->
                <ColumnDefinition Width="2*"/> <!-- Details/CRUD Form -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Talkshows list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- List Header actions -->
                    <RowDefinition Height="*"/>    <!-- List Grid -->
                </Grid.RowDefinitions>
                
                <Button Grid.Row="0" Content="REFRESH SCHEDULE" Height="32" Padding="15,0" Margin="0,0,0,15"
                        Style="{StaticResource P3RSecondaryButtonStyle}" Command="{Binding LoadTalkshowsCommand}"/>
                
                <DataGrid Grid.Row="1" Style="{StaticResource P3RDataGridStyle}"
                          ItemsSource="{Binding Talkshows}"
                          SelectedItem="{Binding SelectedTalkshow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TALKSHOW TITLE" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="SPEAKER" Binding="{Binding SpeakerName}" Width="1.5*"/>
                        <DataGridTextColumn Header="VENUE" Binding="{Binding Venue}" Width="*"/>
                        <DataGridTextColumn Header="START TIME" Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.5*"/>
                        <DataGridTextColumn Header="SEATS" Binding="{Binding RegisteredCount}" Width="0.7*"/>
                        <DataGridTextColumn Header="CAPACITY" Binding="{Binding MaxCapacity}" Width="0.7*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- RIGHT: Actions / Details Card -->
            <Grid Grid.Column="2">
                
                <!-- CARD TYPE A: Admin CRUD Form (visible if CanEdit is True) -->
                <Border Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top"
                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="TALKSHOW BUILDER" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" />

                        <!-- Title -->
                        <TextBlock Text="TITLE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Speaker Name -->
                        <TextBlock Text="SPEAKER NAME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding SpeakerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Speaker Bio -->
                        <TextBlock Text="SPEAKER BIO" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding SpeakerBio, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Venue & Max Capacity -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VENUE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Venue, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CAPACITY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding MaxCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Start and End dates -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="START TIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <DatePicker Height="32" SelectedDate="{Binding StartTime}" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="END TIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <DatePicker Height="32" SelectedDate="{Binding EndTime}" Foreground="White"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Height="36" Command="{Binding SaveCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource P3RPrimaryButtonStyle}">
                                        <Setter Property="Content" Value="CREATE TALKSHOW"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="SAVE CHANGES"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Grid Grid.Column="2">
                                <Button Content="CLEAR" Height="36" Command="{Binding ClearFormCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource P3RSecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="ADVANCE STATUS" Height="36" Command="{Binding AdvanceStatusCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource P3RSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD TYPE B: Attendee Details View (visible if CanEdit is False) -->
                <Border Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <Grid>
                        <!-- Prompt user to select if null -->
                        <TextBlock Text="Select a talkshow to view details and register." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,50,0,50" TextAlignment="Center" Height="50" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTalkshow}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Display Info if Selected -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTalkshow}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="TALKSHOW DETAILS" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" />
                            
                            <TextBlock Text="TITLE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding SelectedTalkshow.Title}" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="SPEAKER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding SelectedTalkshow.SpeakerName}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding SelectedTalkshow.SpeakerBio}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="VENUE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding SelectedTalkshow.Venue}" Foreground="White" FontSize="12" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="START" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SelectedTalkshow.StartTime, StringFormat='yyyy-MM-dd HH:mm'}" Foreground="White" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STATUS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SelectedTalkshow.Status}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#1A2F4C" Margin="0,10,0,15"/>

                            <!-- Seats info -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                                <TextBlock Text="RESERVED SEATS: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTalkshow.RegisteredCount}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text=" / " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTalkshow.MaxCapacity}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Alert Display message -->
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Register Button (Enabled if scheduled) -->
                            <Button Content="REGISTER FOR SEAT" Height="40" Style="{StaticResource P3RPrimaryButtonStyle}" Command="{Binding RegisterCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
