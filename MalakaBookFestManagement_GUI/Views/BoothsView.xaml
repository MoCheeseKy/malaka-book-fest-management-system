<UserControl x:Class="MalakaBookFestManagement_GUI.Views.BoothsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Progress -->
            <RowDefinition Height="*"/>    <!-- Content Split -->
        </Grid.RowDefinitions>

        <ProgressBar Style="{StaticResource P3RProgressBarStyle}" IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     VerticalAlignment="Top" Margin="0,-15,0,15"/>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BOOTHS MANAGEMENT" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Manage and register organizer booths for the festival." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- CRUD Grid Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Booths List -->
                <ColumnDefinition Width="30"/>  <!-- Gap -->
                <ColumnDefinition Width="2*"/> <!-- Form -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Booths list -->
            <DataGrid Grid.Column="0" Style="{StaticResource P3RDataGridStyle}"
                      ItemsSource="{Binding Booths}"
                      SelectedItem="{Binding SelectedBooth}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NUMBER" Binding="{Binding BoothNumber}" Width="0.7*"/>
                    <DataGridTextColumn Header="BOOTH NAME" Binding="{Binding BoothName}" Width="2*"/>
                    <DataGridTextColumn Header="ORGANIZER" Binding="{Binding OrganizerName}" Width="1.5*"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.2*"/>
                    <DataGridTextColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="0.7*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- RIGHT: Form -->
            <Border Grid.Column="2" Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="BOOTH REGISTRATION" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" />

                    <!-- Form Inputs (Enabled only if user has CanEdit permission) -->
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <!-- Booth Name -->
                        <TextBlock Text="BOOTH NAME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding BoothName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Booth Number -->
                        <TextBlock Text="BOOTH NUMBER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <!-- Disable editing Booth Number if updating an existing booth -->
                        <TextBox Height="32" 
                                 Text="{Binding BoothNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,15">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource P3RTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <!-- Category Selection -->
                        <TextBlock Text="CATEGORY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <ComboBox Height="32" Style="{StaticResource P3RComboBoxStyle}" 
                                  ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding Category}" 
                                  Margin="0,0,0,15"/>
                        
                        <!-- IsActive Checkbox -->
                        <CheckBox IsChecked="{Binding IsActive}" Foreground="White" Margin="0,0,0,20" VerticalContentAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="Box" Width="16" Height="16" BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="1" Background="Transparent" CornerRadius="2" Margin="0,0,8,0">
                                                        <Path x:Name="Check" Data="M 2 5 L 5 8 L 10 2" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                                                    </Border>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                            <TextBlock Text="ACTIVE BOOTH (IN OPERATION)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- Status Display -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Action Buttons -->
                    <Grid IsEnabled="{Binding CanEdit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0" Height="36" Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource P3RPrimaryButtonStyle}">
                                    <Setter Property="Content" Value="CREATE BOOTH"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Content" Value="SAVE CHANGES"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Cancel/Delete Split -->
                        <Grid Grid.Column="2">
                            <!-- Clear / Reset Button -->
                            <Button Content="CLEAR" Height="36" Command="{Binding ClearFormCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource P3RSecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Delete Button (Visible only in Edit mode) -->
                            <Button Content="DELETE" Height="36" Command="{Binding DeleteCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource P3RDangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Attendee Helper Notice -->
                    <Border BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="4" Background="#122543" Margin="0,10,0,0" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Viewing only. Only Organizers and Admins can create or modify active booths." 
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
