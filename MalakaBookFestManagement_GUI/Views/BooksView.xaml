<UserControl x:Class="MalakaBookFestManagement_GUI.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Progress -->
            <RowDefinition Height="*"/>    <!-- Main CRUD Split -->
        </Grid.RowDefinitions>

        <ProgressBar Style="{StaticResource P3RProgressBarStyle}" IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     VerticalAlignment="Top" Margin="0,-15,0,15"/>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BOOKS CATALOG" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Browse and manage book inventory. Select a booth to filter books." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- CRUD Grid split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- List Grid -->
                <ColumnDefinition Width="30"/>  <!-- Gap -->
                <ColumnDefinition Width="2*"/> <!-- Form Panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Booth selector and books list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Booth combobox -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="SELECT BOOTH: " Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                    <ComboBox Width="250" Style="{StaticResource P3RComboBoxStyle}" 
                              ItemsSource="{Binding Booths}" 
                              SelectedItem="{Binding SelectedBooth}" 
                              DisplayMemberPath="BoothName"/>
                </StackPanel>

                <!-- DataGrid List -->
                <DataGrid Grid.Row="1" Style="{StaticResource P3RDataGridStyle}" 
                          ItemsSource="{Binding Books}" 
                          SelectedItem="{Binding SelectedBook}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="1.5*"/>
                        <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="*"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat='Rp {0:N0}'}" Width="*"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="0.7*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- RIGHT: CRUD Form Card -->
            <Border Grid.Column="2" Background="{StaticResource GlassBgBrush}" BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="8" Padding="25" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="BOOK DETAILS" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" />

                    <!-- Form Inputs (Enabled only if user has CanEdit permission) -->
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <!-- Title -->
                        <TextBlock Text="TITLE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Author -->
                        <TextBlock Text="AUTHOR" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- ISBN -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ISBN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Isbn, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PRICE (IDR)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G0}'}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Stock -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STOCK" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Cover Image URL -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COVER URL" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox Height="32" Style="{StaticResource P3RTextBoxStyle}" Text="{Binding CoverUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Status Display -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,10,0,15" TextWrapping="Wrap" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Action Buttons -->
                    <Grid IsEnabled="{Binding CanEdit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Save Button -->
                        <Button Grid.Column="0" Height="36" Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource P3RPrimaryButtonStyle}">
                                    <Setter Property="Content" Value="CREATE NEW"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Content" Value="SAVE CHANGES"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Actions split (Reset or Delete) -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Cancel edit / Clear button -->
                            <Button Content="CLEAR" Height="36" Command="{Binding ClearFormCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource P3RSecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Delete button (visible in Edit mode) -->
                            <Button Content="DELETE BOOK" Height="36" Command="{Binding DeleteCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource P3RDangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                    
                    <!-- Attendee helper text -->
                    <Border BorderBrush="#1A2F4C" BorderThickness="1" CornerRadius="4" Background="#122543" Margin="0,10,0,0" Padding="10"
                            Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <!-- Visible only if CanEdit is false. Wait, standard BooleanToVisibilityConverter cannot invert unless we declare a converter parameter trigger, but we can do a simple Style trigger! -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Viewing only. Only Organizers and Admins can create or update book inventories." 
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
