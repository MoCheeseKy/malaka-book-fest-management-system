<Application x:Class="MalakaBookFestManagementSystem_GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MalakaBookFestManagementSystem_GUI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Persona 3 Reload Colors -->
        <SolidColorBrush x:Key="P3DeepBlue" Color="#0A142A" />
        <SolidColorBrush x:Key="P3Cyan" Color="#00A8FF" />
        <SolidColorBrush x:Key="P3White" Color="#FFFFFF" />
        <SolidColorBrush x:Key="P3DarkGrey" Color="#1E2336" />
        <SolidColorBrush x:Key="P3HoverCyan" Color="#33B5E5" />
        <SolidColorBrush x:Key="P3Red" Color="#FF3366" />
        <SolidColorBrush x:Key="P3Green" Color="#00E676" />

        <!-- Base Window Style -->
        <Style TargetType="Window" x:Key="P3WindowStyle">
            <Setter Property="Background" Value="{StaticResource P3DeepBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource P3White}"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Base TextBlock Style -->
        <Style TargetType="TextBlock" x:Key="P3TextStyle">
            <Setter Property="Foreground" Value="{StaticResource P3White}"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Form TextBox Style -->
        <Style TargetType="TextBox" x:Key="P3TextBoxStyle">
            <Setter Property="Background" Value="{StaticResource P3DarkGrey}"/>
            <Setter Property="Foreground" Value="{StaticResource P3White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource P3Cyan}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="P3ComboBoxStyle">
            <Setter Property="Background" Value="{StaticResource P3DarkGrey}"/>
            <Setter Property="Foreground" Value="{StaticResource P3DeepBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource P3Cyan}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Slanted Button Style -->
        <Style TargetType="Button" x:Key="P3ButtonStyle">
            <Setter Property="Background" Value="{StaticResource P3Cyan}"/>
            <Setter Property="Foreground" Value="{StaticResource P3DeepBlue}"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Slanted Background -->
                            <Polygon Points="15,0 120,0 105,45 0,45" Stretch="Fill" Fill="{TemplateBinding Background}" x:Name="bg"/>
                            <!-- Text content (unslanted) -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="{StaticResource P3White}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Fill" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style TargetType="Button" BasedOn="{StaticResource P3ButtonStyle}" x:Key="P3DangerButtonStyle">
            <Setter Property="Background" Value="{StaticResource P3Red}"/>
            <Setter Property="Foreground" Value="{StaticResource P3White}"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource P3ButtonStyle}" x:Key="P3SuccessButtonStyle">
            <Setter Property="Background" Value="{StaticResource P3Green}"/>
            <Setter Property="Foreground" Value="{StaticResource P3DeepBlue}"/>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource P3DeepBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource P3White}"/>
            <Setter Property="RowBackground" Value="{StaticResource P3DarkGrey}"/>
            <Setter Property="AlternatingRowBackground" Value="#151A2B"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource P3Cyan}"/>
            <Setter Property="Foreground" Value="{StaticResource P3DeepBlue}"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005580"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#003366"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
