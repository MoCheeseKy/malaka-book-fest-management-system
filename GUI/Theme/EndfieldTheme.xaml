<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="HarmonyOS">pack://application:,,,/Fonts/#HarmonyOS Sans</FontFamily>
    
    <!-- EXTREME Persona 3 Reload Colors -->
    <!-- Vibrant saturated blues for pure S.E.E.S aesthetics -->
    <Color x:Key="P3BackgroundColor">#001D4A</Color>
    <Color x:Key="P3PanelColor">#00317A</Color>
    <Color x:Key="P3PanelLightColor">#0047AB</Color>
    <Color x:Key="P3PanelBorderColor">#00E5FF</Color>
    
    <!-- Accents (Electric Cyan & Magenta) -->
    <Color x:Key="P3AccentColor">#00D4FF</Color>
    <Color x:Key="P3AccentHoverColor">#80F2FF</Color>
    <Color x:Key="P3SecondaryAccentColor">#FFFFFF</Color>
    <Color x:Key="P3DangerColor">#FF007F</Color>
    
    <!-- Text Colors -->
    <Color x:Key="P3TextColor">#FFFFFF</Color>
    <Color x:Key="P3MutedTextColor">#A1BDE6</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource P3BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource P3PanelColor}" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource P3PanelLightColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource P3PanelBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource P3AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource P3AccentHoverColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource P3SecondaryAccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource P3DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource P3TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource P3MutedTextColor}" />

    <!-- Pure Vibrant Solid Background for the Window (Gradients are too subtle for P3R) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#002A6B" />

    <!-- Card Background (Deep Blue Translucent Glass) -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#D9001D4A" />

    <!-- DropShadows for that high-contrast glow -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.6" BlurRadius="25" Direction="315" ShadowDepth="15" />
    <DropShadowEffect x:Key="GlowShadowCyan" Color="{StaticResource P3AccentColor}" Opacity="1.0" BlurRadius="25" ShadowDepth="0" />
    <DropShadowEffect x:Key="GlowShadowMagenta" Color="{StaticResource P3DangerColor}" Opacity="1.0" BlurRadius="25" ShadowDepth="0" />

    <!-- BASE INHERITANCE -->
    <Style TargetType="Window">
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource HarmonyOS}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- P3R SLANTED BUTTON (Primary - Cyan) -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#001D4A" /> <!-- Dark Blue text -->
        <Setter Property="TextElement.Foreground" Value="#001D4A" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="35,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- Slanted Container -->
                        <Border x:Name="bgBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-20"/>
                            </Border.RenderTransform>
                            <!-- Un-slanted Content -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <SkewTransform AngleX="20"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="bgBorder" Property="Effect" Value="{StaticResource GlowShadowCyan}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bgBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-20"/>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bgBorder" Property="Background" Value="{StaticResource PanelLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- P3R SLANTED SECONDARY BUTTON (Hollow Cyan) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="30,10" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bgBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-20"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <SkewTransform AngleX="20"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="Background" Value="#3300D4FF" />
                            <Setter TargetName="bgBorder" Property="Effect" Value="{StaticResource GlowShadowCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- P3R NAV BUTTON (Slanted Left Highlight) -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}" />
        <!-- Big thick left border in P3R style -->
        <Setter Property="BorderThickness" Value="10,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="20,15" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bgBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <!-- Slant the entire background block -->
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-15"/>
                            </Border.RenderTransform>
                            <!-- Keep text straight -->
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <SkewTransform AngleX="15"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bgBorder" Property="Background" Value="#1A00D4FF" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="bgBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="bgBorder" Property="Effect" Value="{StaticResource GlowShadowCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- P3R TABLE ACTION BUTTON (Slanted Small Hollow) -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bg" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-15"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <SkewTransform AngleX="15"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="bg" Property="Effect" Value="{StaticResource GlowShadowCyan}" />
                            <Setter Property="Foreground" Value="#001D4A" />
                            <Setter Property="TextElement.Foreground" Value="#001D4A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- P3R DANGER ACTION BUTTON (Magenta) -->
    <Style x:Key="ActionDangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-15"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <SkewTransform AngleX="15"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource DangerBrush}" />
                            <Setter TargetName="bg" Property="Effect" Value="{StaticResource GlowShadowMagenta}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- P3R TECH CARD (Dark Glass Panel) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <!-- Cyan vibrant border -->
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="30" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- TextBox P3R Style -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="Background" Value="#0A001D4A" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <!-- Bottom border only for sleek modern look -->
        <Setter Property="BorderBrush" Value="{StaticResource PanelLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bgBorder"
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bgBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="bgBorder" Property="Background" Value="#330047AB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox P3R Style -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="Background" Value="#002A6B" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- P3R DataGrid Style -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#0C00E5FF" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="60" />
    </Style>
    
    <!-- DataGrid Headers (S.E.E.S Styled) -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HarmonyOS}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Padding" Value="15,10,15,15" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid Rows -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#3300D4FF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3300D4FF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#6600D4FF" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGridCell Style -->
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
